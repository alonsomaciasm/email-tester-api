# ==============================================================================
# Environment & Service Metadata
# ==============================================================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
SERVICE_NAME=email-tester-api
SECRET_SALT=4f8b92e10a23d45c6789bf0123456789abcdef0123456789abcdef0123456789

# ==============================================================================
# Redis Configuration
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20
REDIS_CACHE_TTL_MX_SECONDS=86400

# ==============================================================================
# Security & Authentication
# ==============================================================================
API_KEY_HEADER_NAME=X-API-Key
ALLOWED_API_KEYS=["secret-api-key-change-me-in-production"]
REQUIRE_API_KEY=false

# ==============================================================================
# Rate Limiting
# ==============================================================================
RATE_LIMIT_IP_REQUESTS=100
RATE_LIMIT_APIKEY_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=60

# ==============================================================================
# DNS Resolver Settings
# ==============================================================================
DNS_RESOLVER_TIMEOUT=1.5
DNS_RESOLVER_LIFETIME=2.0
DNS_NAMESERVERS=["1.1.1.1","8.8.8.8","9.9.9.9"]

# ==============================================================================
# Bloom Filter Dataset Settings
# ==============================================================================
BLOOM_FILTER_EXPECTED_ITEMS=500000
BLOOM_FILTER_ERROR_RATE=0.001
DATASET_SOURCE_URLS=["https://raw.githubusercontent.com/disposable-email-domains/disposable-email-domains/main/disposable_email_blocklist.conf", "https://raw.githubusercontent.com/ivolo/disposable-email-domains/master/index.json"]

# ==============================================================================
# Docker Container Resource Limits & Reservations (vCPU & RAM)
# ==============================================================================
API_CPU_LIMIT=1.5
API_MEM_LIMIT=512M
API_CPU_RESERV=0.25
API_MEM_RESERV=128M

REDIS_CPU_LIMIT=0.5
REDIS_MEM_LIMIT=256M
REDIS_CPU_RESERV=0.1
REDIS_MEM_RESERV=64M
REDIS_MAXMEMORY=256mb
